{#- ─────────────────────────────────────────────────────────────────────────
    reTerminal panels – PLANTS (used by panel_plants.yaml)
    Put this file in  <config>/custom_templates/panel_plants.jinja

    Which room each plant is in, and the temperature it gets
    Rooms are picked with the "Plant N Room" selects in Home Assistant
    (stored in sensor.panel_plant_rooms). A plant that hasn't been given a
    room yet gets a fixed pseudo-random one of the rooms with a sensor.
    Temperature: its room's sensor → else the average of its floor →
    else the average of the whole house.
    ───────────────────────────────────────────────────────────────────────── -#}

{#- one line per plant 1…15: "area_id|room name|floor name|temp|source"
      rooms   sensor.panel_rooms' "rooms" attribute
      saved   sensor.panel_plant_rooms' "rooms" attribute ({"1": area_id, …})
    source = room | floor | house ('' = no temperature anywhere) -#}
{%- macro plant_table(rooms, saved) -%}
  {%- set ns = namespace(rt=[], fl={}, hs=0, hc=0, out=[]) -%}
  {%- for r in ((rooms or '') | string | trim | replace('\n', '')).split(';') if r -%}
    {%- set f = r.split('|') -%}
    {%- if f | count > 2 and f[2] != '' -%}
      {%- set t = f[2] | float -%}
      {%- set ns.rt = ns.rt + [[f[0], t]] -%}
      {%- set fid = floor_id(f[0]) or '' -%}
      {%- if fid -%}
        {%- set cur = ns.fl.get(fid, [0, 0]) -%}
        {%- set ns.fl = dict(ns.fl, **{fid: [cur[0] + t, cur[1] + 1]}) -%}
      {%- endif -%}
      {%- set ns.hs = ns.hs + t -%}{%- set ns.hc = ns.hc + 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set rt = ns.rt | sort(attribute=0) -%}
  {%- set all_areas = areas() -%}
  {%- set saved = saved if saved is mapping else {} -%}
  {%- for n in range(1, 16) -%}
    {%- set a = saved.get(n | string, '') -%}
    {%- if not a or a not in all_areas -%}
      {%- set a = rt[((n - 1) * 7 + 3) % (rt | count)][0] if rt else '' -%}
    {%- endif -%}
    {%- set temp = namespace(v='', src='') -%}
    {%- for x in rt if x[0] == a -%}{%- set temp.v = x[1] -%}{%- set temp.src = 'room' -%}{%- endfor -%}
    {%- set fid = (floor_id(a) or '') if a else '' -%}
    {%- if temp.v == '' and fid and fid in ns.fl -%}
      {%- set temp.v = (ns.fl[fid][0] / ns.fl[fid][1]) | round(1) -%}{%- set temp.src = 'floor' -%}
    {%- endif -%}
    {%- if temp.v == '' and ns.hc -%}
      {%- set temp.v = (ns.hs / ns.hc) | round(1) -%}{%- set temp.src = 'house' -%}
    {%- endif -%}
    {%- set name = ((area_name(a) or '') if a else '') | replace('|', '/') | replace(';', ',') -%}
    {%- set floor = ((floor_name(fid) or '') if fid else '') | replace('|', '/') | replace(';', ',') -%}
    {%- set ns.out = ns.out + [[a, name, floor, temp.v, temp.src] | join('|')] -%}
  {%- endfor -%}
  {{- ns.out | join(';') -}}
{%- endmacro -%}

{#- average temperature per floor, as "Floor name|avg;…" (from panel_rooms) -#}
{%- macro floor_temps(rooms) -%}
  {%- set ns = namespace(fl={}, out=[]) -%}
  {%- for r in ((rooms or '') | string | trim | replace('\n', '')).split(';') if r -%}
    {%- set f = r.split('|') -%}
    {%- if f | count > 2 and f[2] != '' -%}
      {%- set fid = floor_id(f[0]) or '' -%}
      {%- if fid -%}
        {%- set cur = ns.fl.get(fid, [0, 0]) -%}
        {%- set ns.fl = dict(ns.fl, **{fid: [cur[0] + f[2] | float, cur[1] + 1]}) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for fid, v in ns.fl.items() -%}
    {%- set ns.out = ns.out + [(floor_name(fid) or fid) ~ '|' ~ ((v[0] / v[1]) | round(1))] -%}
  {%- endfor -%}
  {{- ns.out | join(';') -}}
{%- endmacro -%}

{#- ── Water left per plant (the reservoirs live in Home Assistant) ──────────
    Each plant has a reservoir of "Plant Reservoir" glasses. It empties by
    glass ÷ days-per-glass a day at 20 °C, twice as fast for every 10 °C warmer
    (half for every 10 °C cooler), times "Plant Water Multiplier".
    The temperature is the plant's room (or floor, or house) from panel_plants. -#}

{#- the temperature plant n (1…15) gets, 5–35 °C (20 °C when nothing is known) -#}
{%- macro plant_temp(n) -%}
  {%- set rows = (state_attr('sensor.panel_plants', 'plants') or '') | string -%}
  {%- set row = (rows.split(';') + [''] * 15)[n - 1] -%}
  {%- set f = (row.split('|') + ['', '', '', '', ''])[:5] -%}
  {%- set house = states('sensor.panel_floor_temperatures') | float(20) -%}
  {%- set t = f[3] | float(house) if f[3] != '' else house -%}
  {{- [35, [5, t] | max] | min -}}
{%- endmacro -%}

{#- ml a day plant n drinks right now -#}
{%- macro plant_per_day(n) -%}
  {%- set glass = states('input_number.plant_' ~ n ~ '_glass_ml') | float(250) -%}
  {%- set days = states('input_number.plant_' ~ n ~ '_days') | float(7) -%}
  {%- set days = days if days > 0 else 7 -%}
  {%- set m = states('input_number.plant_water_multiplier') | float(1) -%}
  {{- glass / days * (2 ** ((plant_temp(n) | float - 20) / 10)) * m -}}
{%- endmacro -%}

{#- every plant that's in use, as JSON:
    [{"n": 1, "name": "Monstera", "room": "Living room", "left": 2.3, "pct": 45, "level": 270, "cap": 600}, …]
    "left" = days of water left; plants named "-" are skipped (not in use) -#}
{%- macro plant_status() -%}
  {%- set res = states('input_number.plant_reservoir_glasses') | float(2) -%}
  {%- set rooms = ((state_attr('sensor.panel_plants', 'plants') or '') | string).split(';') + [''] * 15 -%}
  {%- set ns = namespace(out=[]) -%}
  {%- for n in range(1, 16) -%}
    {%- set nm = states('input_text.plant_' ~ n ~ '_name') -%}
    {%- set nm = (nm if nm not in ['unknown', 'unavailable'] else '') | trim -%}
    {#- empty name: the sample name (the same as the reTerminal's own) -#}
    {%- set nm = nm or ['Monstera', 'Snake plant', 'Peace lily', 'Orchid', 'Cactus', 'Basil', 'Fiddle fig', 'Pothos',
        'Aloe vera', 'Spider plant', 'Kentia palm', 'Jade plant', 'Chili pepper', 'Tulips', 'Calathea'][n - 1] -%}
    {%- if nm != '-' -%}
      {%- set glass = states('input_number.plant_' ~ n ~ '_glass_ml') | float(250) -%}
      {%- set level = states('input_number.plant_' ~ n ~ '_level') | float(0) -%}
      {%- set cap = glass * res -%}
      {%- set pd = plant_per_day(n) | float(0) -%}
      {%- set room = (rooms[n - 1].split('|') + ['', ''])[1] -%}
      {%- set ns.out = ns.out + [{'n': n, 'name': nm, 'room': room,
          'left': ((level / pd) if pd > 0 else 0) | round(1),
          'pct': ([100, (level / cap * 100) if cap > 0 else 0] | min) | round(0),
          'level': level | round(0), 'cap': cap | round(0)}] -%}
    {%- endif -%}
  {%- endfor -%}
  {{- ns.out | tojson -}}
{%- endmacro -%}
